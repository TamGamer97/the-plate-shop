# Stripe keys: https://dashboard.stripe.com/apikeys (use sk_test_... while testing)
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret: from Dashboard > Developers > Webhooks, or `stripe listen` locally
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public URL of the site for Stripe redirects (optional; Netlify provides URL automatically)
SITE_URL=http://localhost:8888
